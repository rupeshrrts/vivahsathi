# Copy to .env (never commit .env) or set these in your hosting dashboard.
# All are optional: keys can also be entered in Admin → Payments & SMS OTP. Values set here win over Admin.

PORT=3000
# Set to 1 only on an isolated staging/demo server to seed sample data and allow test integrations.
# DEMO_DATA=1
# Set to 1 when the app runs behind a proxy / load balancer (Render, Railway, Fly.io, Nginx, Cloudflare) so login and
# OTP limits see each visitor's real address. Leave empty when visitors reach Node directly (then the header is ignored).
TRUST_PROXY=
# First start only: the admin password for a brand-new site (8+ characters). Leave empty and a random one is written
# to DATA_DIR/ADMIN-LOGIN.txt. It is never "Admin@123".
ADMIN_PASSWORD=
# Folder for db.json and private vendor documents (point it at a persistent disk on your host)
DATA_DIR=./database/data
# Optional folder for public uploaded images. For one mounted disk, use a separate uploads subfolder.
# UPLOAD_DIR=/mnt/vivah/uploads

# Supabase: live copy of all data, kept up to date by the server (Project Settings → API).
# The service-role key is secret: only here / in the host's settings, never in a web page or in git.
# With the access token (Account → Access Tokens) the tables are made and updated from database/schema.sql at every
# start. On a new server with an empty data folder, these two let it start from the last copy in Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ACCESS_TOKEN=

# Razorpay (online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS OTP: console (test mode, prints the OTP in the server log) | fast2sms | custom
SMS_PROVIDER=
FAST2SMS_API_KEY=
# custom provider: send URL with {phone} and {otp} placeholders
SMS_URL_TEMPLATE=

# Google Maps (optional; distances work without it)
GOOGLE_MAPS_KEY=
# set to 1 to turn off address → map lookups
NO_GEOCODE=
